#!/bin/sh
set -eu

WL=/tmp/weston.log
RD=/run/user/0
echo "[weston-start] preparing runtime"

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

install_deps() {
    has_cmd weston && has_cmd seatd && has_cmd weston-simple-shm && has_cmd xterm && has_cmd xclock && return 0
    if ! has_cmd apt-get; then
        echo "[weston-start] apt-get is required by the Debian rootfs"
        return 1
    fi
    # Reusing apt list files across X-Kernel boots currently leaves clearsigned
    # InRelease files that apt cannot split; fetch a clean set for this run.
    if ! find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -print -quit 2>/dev/null | grep -q .; then
        echo "[weston-start] updating apt indexes"
        apt-get update || return 1
    else
        echo "[weston-start] using existing apt indexes"
    fi
    echo "[weston-start] installing Weston packages"
    # Do not let Debian package maintscripts start daemons in the guest boot
    # session; Weston is started explicitly below.
    printf '#!/bin/sh\nexit 101\n' >/usr/sbin/policy-rc.d
    chmod 0755 /usr/sbin/policy-rc.d
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends weston xwayland xterm x11-apps seatd || return 1
    rm -f /usr/sbin/policy-rc.d

    has_cmd weston && has_cmd seatd && has_cmd weston-simple-shm && has_cmd xterm && has_cmd xclock && return 0
    echo "[weston-start] missing command after install:"
    for c in weston seatd weston-simple-shm xterm xclock; do
        has_cmd "$c" || echo "  $c"
    done
    return 1
}

install_deps || exit 1
mkdir -p "$RD"
chmod 700 "$RD"
mkdir -p /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix
WP=$(pgrep -x weston | head -n 1 || true)
if [ -z "$WP" ]; then
    rm -f "$RD"/wayland-* "$RD"/wayland-*.lock /run/seatd.sock
    rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
    rm -f "$WL" /tmp/weston-watch.log /tmp/xterm.log /tmp/xclock.log
fi
mkdir -p /run/udev/data
if [ -e /dev/dri/card0 ]; then
    # Weston resolves an explicitly selected DRM node through libudev before
    # opening it. X-Kernel's sysfs is currently a writable compatibility tree,
    # so publish the minimal class metadata paired with devtmpfs card0.
    DRM_SYSDEV=/sys/devices/virtual/drm/card0
    mkdir -p "$DRM_SYSDEV" /sys/class/drm /sys/dev/char
    rm -rf /sys/class/drm/card0 /sys/dev/char/226:0
    printf '226:0\n' >"$DRM_SYSDEV/dev"
    cat >"$DRM_SYSDEV/uevent" <<'EOF'
DEVPATH=/devices/virtual/drm/card0
DEVNAME=dri/card0
MAJOR=226
MINOR=0
SUBSYSTEM=drm
DEVTYPE=drm_minor
EOF
    ln -s ../../../../class/drm "$DRM_SYSDEV/subsystem"
    ln -s ../../devices/virtual/drm/card0 /sys/class/drm/card0
    ln -s ../../devices/virtual/drm/card0 /sys/dev/char/226:0
fi
input_minor=1
for event_node in /dev/input/event*; do
    [ -e "$event_node" ] || continue
    event_name=${event_node##*/}
    input_name=input$((input_minor - 1))
    input_sysdev=/sys/devices/virtual/input/$input_name
    event_sysdev=$input_sysdev/$event_name
    mkdir -p "$event_sysdev" /sys/class/input /sys/dev/char
    rm -rf "/sys/class/input/$event_name" "/sys/dev/char/13:$input_minor"
    printf '13:%s\n' "$input_minor" >"$event_sysdev/dev"
    cat >"$event_sysdev/uevent" <<EOF
DEVPATH=/devices/virtual/input/$input_name/$event_name
DEVNAME=input/$event_name
MAJOR=13
MINOR=$input_minor
SUBSYSTEM=input
EOF
    printf 'X-Kernel virtio input\n' >"$input_sysdev/name"
    ln -sf ../../../../class/input "$input_sysdev/subsystem"
    ln -sf ../../../../../class/input "$event_sysdev/subsystem"
    ln -sf "../../devices/virtual/input/$input_name/$event_name" \
        "/sys/class/input/$event_name"
    ln -sf "../../devices/virtual/input/$input_name/$event_name" \
        "/sys/dev/char/13:$input_minor"
    # libinput verifies the actual evdev capabilities after using these udev
    # tags to select candidate devices. Publishing both candidate classes
    # keeps this compatibility metadata independent of virtio device order.
    cat >"/run/udev/data/c13:$input_minor" <<'EOF'
E:ID_INPUT=1
E:ID_INPUT_KEYBOARD=1
E:ID_INPUT_MOUSE=1
E:ID_SEAT=seat0
EOF
    input_minor=$((input_minor + 1))
done

pgrep seatd >/dev/null 2>&1 || {
    echo "[weston-start] starting seatd"
    seatd -g root -l debug >/tmp/seatd.log 2>&1 &
    sleep 1
}

if [ -z "$WP" ]; then
    echo "[weston-start] starting weston"
    if [ -e /dev/dri/card0 ]; then
        BACKEND_ARGS="--backend=drm-backend.so --drm-device=card0 --seat=seat0"
        EXTRA_ARGS="--continue-without-input"
        SHELL_ARGS="--shell=desktop-shell.so"
    else
        BACKEND_ARGS="--backend=headless-backend.so"
        EXTRA_ARGS=""
        SHELL_ARGS="--shell=desktop-shell.so"
    fi
    env XDG_RUNTIME_DIR="$RD" WESTON_DISABLE_ATOMIC=1 \
        LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-noop}" weston \
        $BACKEND_ARGS --renderer=pixman \
        $EXTRA_ARGS $SHELL_ARGS --idle-time=0 --log="$WL" &
    WP=$!
    (
        while kill -0 "$WP" >/dev/null 2>&1; do
            date
            ps | grep -E 'weston|Xwayland|xterm|xclock' | grep -v grep || true
            sleep 30
        done
    ) >/tmp/weston-watch.log 2>&1 &
else
    echo "[weston-start] weston already running"
fi

i=0
WD=
while [ "$i" -lt 50 ]; do
    kill -0 "$WP" >/dev/null 2>&1 || {
        echo "[weston-start] weston failed"
        cat "$WL" 2>/dev/null || true
        exit 1
    }
    C=$(find "$RD" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | head -n 1)
    [ -n "$C" ] && { WD=${C##*/}; break; }
    i=$((i + 1))
    sleep 0.1
done

[ -n "$WD" ] || exit 1
CLIENT=${XK_WESTON_CLIENT:-xterm,xclock}
if [ ! -e /dev/dri/card0 ] && [ -z "${XK_WESTON_CLIENT:-}" ]; then
    CLIENT=none
fi
if [ "$CLIENT" = "none" ]; then
    echo "[weston-start] client startup disabled"
    [ "${XK_WESTON_WAIT:-0}" = "1" ] && while kill -0 "$WP" >/dev/null 2>&1; do sleep 60; done
    exit 0
fi
if [ "$CLIENT" = "xterm" ] || [ "$CLIENT" = "xclock" ] ||
    [ "$CLIENT" = "xterm,xclock" ] || [ "$CLIENT" = "xclock,xterm" ]; then
    i=0
    while [ "$i" -lt 50 ] && [ ! -S /tmp/.X11-unix/X0 ]; do
        kill -0 "$WP" >/dev/null 2>&1 || {
            echo "[weston-start] weston failed"
            cat "$WL" 2>/dev/null || true
            exit 1
        }
        i=$((i + 1))
        sleep 0.1
    done
    [ -S /tmp/.X11-unix/X0 ] || {
        echo "[weston-start] Xwayland display :0 did not appear"
        cat "$WL" 2>/dev/null || true
        exit 1
    }

    # The Xwayland module exposes the X11 socket before the Xwayland process
    # and Weston XWM are fully established.  Start one real client to trigger
    # Xwayland, then wait for the WM handoff before starting the next client.
    if [ "$CLIENT" = "xterm" ] || [ "$CLIENT" = "xterm,xclock" ] ||
        [ "$CLIENT" = "xclock,xterm" ]; then
        echo "[weston-start] starting xterm"
        DISPLAY=:0 xterm -title "X-Kernel xterm" -geometry 52x15+20+230 \
            -bg black -fg white -cr green -ls >/tmp/xterm.log 2>&1 &
    elif [ "$CLIENT" = "xclock" ]; then
        echo "[weston-start] starting xclock"
        DISPLAY=:0 xclock -geometry 150x150+455+55 -update 1 >/tmp/xclock.log 2>&1 &
    fi

    i=0
    while [ "$i" -lt 300 ] && ! grep -q 'created wm' "$WL" 2>/dev/null; do
        kill -0 "$WP" >/dev/null 2>&1 || {
            echo "[weston-start] weston failed"
            cat "$WL" 2>/dev/null || true
            exit 1
        }
        if [ "$i" -gt 0 ] && [ $((i % 50)) -eq 0 ]; then
            echo "[weston-start] still waiting for Xwayland window manager ($((i / 10))s)"
        fi
        i=$((i + 1))
        sleep 0.1
    done
    grep -q 'created wm' "$WL" 2>/dev/null || {
        echo "[weston-start] Xwayland window manager did not become ready"
        cat "$WL" 2>/dev/null || true
        exit 1
    }
    sleep 1
    sleep 3
    if [ "$CLIENT" = "xclock" ] || [ "$CLIENT" = "xterm,xclock" ] ||
        [ "$CLIENT" = "xclock,xterm" ]; then
        echo "[weston-start] starting xclock"
        DISPLAY=:0 xclock -geometry 150x150+455+55 -update 1 >/tmp/xclock.log 2>&1 &
        sleep 3
        if ! pgrep -x xclock >/dev/null 2>&1; then
            echo "[weston-start] retrying xclock"
            DISPLAY=:0 xclock -geometry 150x150+455+55 -update 1 >/tmp/xclock.log 2>&1 &
        fi
    fi
elif [ "$CLIENT" = "weston-simple-shm" ]; then
    echo "[weston-start] starting weston-simple-shm"
    env XDG_RUNTIME_DIR="$RD" WAYLAND_DISPLAY="$WD" weston-simple-shm >/tmp/weston-simple-shm.log 2>&1 &
else
    echo "[weston-start] unsupported client: $CLIENT"
    exit 1
fi
echo "[weston-start] weston is running"
[ "${XK_WESTON_WAIT:-0}" = "1" ] && while kill -0 "$WP" >/dev/null 2>&1; do sleep 60; done
