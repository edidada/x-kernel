config KFEAT_DRIVER_RTC_LS7A
    bool "LS7A RTC driver"
    depends on KFEAT_RTC && ARCH_LOONGARCH64
    default y if MACHINE_LOONGARCH64_QEMU
    help
      Loongson LS7A TOY-counter RTC driver on the driver-core model.
