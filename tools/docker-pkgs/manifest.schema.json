{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xk-docker-pkgs-manifest.schema.json",
  "title": "X-Kernel offline Docker assets manifest",
  "description": "Generated by tools/docker-pkgs/build-deb-closure.sh; records versions and provenance of the prebuilt offline Docker assets injected into disk.img.",
  "type": "object",
  "required": ["generated_at", "arch", "platform", "debian_suite", "versions", "images", "commands"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "arch": { "const": "aarch64" },
    "platform": { "type": "string" },
    "debian_suite": { "type": "string" },
    "versions": {
      "type": "object",
      "description": "Package name to resolved dpkg version.",
      "patternProperties": { ".*": { "type": "string" } }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "tag", "file"],
        "properties": {
          "repository": { "type": "string" },
          "tag": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Commands that produced this asset set (reproducibility record)."
    }
  }
}